APP_NAME=Assam Exam AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://assam_admin:assam_dev_password@localhost:5432/assam_exam_ai
OFFICIAL_DISCOVERY_ALLOWED_HOSTS=
OFFICIAL_DISCOVERY_CONNECT_TIMEOUT_SECONDS=5
OFFICIAL_DISCOVERY_READ_TIMEOUT_SECONDS=10
OFFICIAL_DISCOVERY_ROBOTS_MAX_BYTES=262144
OFFICIAL_DISCOVERY_SITEMAP_MAX_BYTES=1048576
OFFICIAL_DISCOVERY_SITEMAP_DOCUMENT_LIMIT=20
OFFICIAL_DISCOVERY_INSPECTED_URL_LIMIT=1000
OFFICIAL_DISCOVERY_CANDIDATE_LIMIT=50
OFFICIAL_DISCOVERY_REDIRECT_LIMIT=3
OFFICIAL_DISCOVERY_USER_AGENT=AssamExamAI-OfficialDiscovery/1.0
